# Copie este arquivo para .env e preencha os valores.
# O arquivo .env NÃO é enviado para o GitHub (está no .gitignore).

# Sua chave da OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=cole_sua_chave_aqui

# Modelo usado (opcional). Padrão: openrouter/free
OPENROUTER_MODEL=openrouter/free

# Chave secreta das sessões do Flask (opcional).
# Gere uma: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
